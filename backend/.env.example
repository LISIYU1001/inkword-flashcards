# Server only. Fill AGNES_API_KEY locally; do not share this file.
AI_PROVIDER=agnes
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash

# Optional: set AI_PROVIDER=openai to use the original provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Public deployment: exact comma-separated browser origins, never use *.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set positive values on Koyeb; 0 disables a limit for local development.
DEMO_REQUESTS_PER_MINUTE=0
DEMO_EXPLANATIONS_PER_DAY=0
